  "sourceNone": "No outside source. This is arithmetic.",
  "formulaMeasuredMaxHrTitle": "Your measured maximum",
  "formulaMeasuredMaxHrHow": "This is the maximum heart rate you entered from your own test or ride. A measured value beats any formula.",
  "formulaTanakaMaxHrTitle": "Age-based estimate",
  "formulaTanakaMaxHrHow": "Maximum heart rate is about 208 minus 0.7 times your age.",
  "formulaTanakaMaxHrLimits": "This is an average for healthy adults. Your real maximum can be quite different, so treat zones built on it as a guide.",
  "formulaFrielLthrZonesTitle": "Zones from your threshold heart rate",
  "formulaFrielLthrZonesHow": "Each zone is a percentage of your lactate-threshold heart rate, using Joe Friel's cycling zones. Zone 5a starts at your threshold.",
  "formulaFrielLthrZonesLimits": "Only as good as the test behind your threshold number. Retest every few months.",
  "formulaKarvonenZonesTitle": "Zones from heart-rate reserve",
  "formulaKarvonenZonesHow": "Your reserve is maximum minus resting heart rate. Each zone is your resting rate plus 50 to 100 percent of that reserve, in steps of 10.",
  "formulaKarvonenZonesLimits": "The 10 percent bands are a common convention, not something measured on you.",
  "formulaPercentMaxHrZonesTitle": "Zones from maximum heart rate",
  "formulaPercentMaxHrZonesHow": "Each zone is 50 to 100 percent of your maximum heart rate, in steps of 10.",
  "formulaPercentMaxHrZonesLimits": "The simplest method and the least personal. Adding your resting heart rate, or doing a threshold test, improves it.",
  "formulaCogganPowerZonesTitle": "Power zones from FTP",
  "formulaCogganPowerZonesHow": "Each level is a percentage of your FTP, the power you can hold for about an hour, using Andrew Coggan's levels.",
  "formulaCogganPowerZonesLimits": "Depends on a recent FTP test.",
  "formulaWattsPerKgTitle": "Power to weight",
  "formulaWattsPerKgHow": "Your FTP divided by your body weight. It is what decides how fast you climb. Weight is used here only for physics.",
  "formulaLemondSaddleHeightTitle": "Saddle-height starting point",
  "formulaLemondSaddleHeightHow": "0.883 times your inseam, measured from the centre of the bottom bracket to the top of the saddle.",
  "formulaLemondSaddleHeightLimits": "Studies show this formula suits average proportions best and often misses for others. Use it to get close, then adjust in small steps, or get a professional fit.",
  "formulaEtrtoCircumferenceTitle": "Wheel size from the tyre label",
  "formulaEtrtoCircumferenceHow": "Pi times the rim diameter plus twice the tyre width, using the ETRTO size printed on the tyre.",
  "formulaEtrtoCircumferenceLimits": "Usually within 1 to 2 percent of the real value. A loaded tyre rolls slightly smaller.",
  "formulaMeasuredCircumferenceTitle": "Your measured wheel size",
  "formulaMeasuredCircumferenceHow": "The distance your bike travels in one wheel turn, as you measured it.",
  "formulaGearCadenceTitle": "Cadence in a gear",
  "formulaGearCadenceHow": "Each crank turn moves you chainring divided by cog, times the wheel circumference. Cadence is your speed divided by that distance.",
  "formulaClimbPowerBalanceTitle": "Climb prediction",
  "formulaClimbPowerBalanceHow": "Your power is balanced against gravity, rolling resistance and air drag to find your speed. That speed is then turned into a cadence for each gear.",
  "formulaClimbPowerBalanceLimits": "Uses typical values for tyres and air drag, and a steady effort on a constant gradient. Real climbs vary.",
  "formulaNwsHeatIndexTitle": "Heat index",
  "formulaNwsHeatIndexHow": "Combines air temperature and humidity into how hot it feels, using the US National Weather Service equation, then sorts it into PAGASA's heat categories.",
  "formulaNwsHeatIndexLimits": "It describes shade with a light wind. Direct sun feels hotter, and hard riding adds your own body heat.",
  "improveMeasureMaxHr": "Enter a maximum heart rate you have actually reached in a hard effort.",
  "improveMeasureRestingHr": "Add your resting heart rate. Count it for a minute just after waking.",
  "improveDoLthrTest": "Do a threshold test: ride hard and steady, alone, for 30 minutes. Your threshold is your average heart rate over the last 20 minutes.",
  "improveDoFtpTest": "Add your FTP from a power test.",
  "improveRollOutWheel": "Measure your wheel: mark the tyre and the ground, roll one full turn while sitting on the bike, and measure the distance.",
  "improveConfirmCogs": "Count the teeth on each cog and confirm them in your bike details.",
  "improveGetProfessionalFit": "A professional bike fit measures your knee angle while you pedal.",
  "improveUsePowerMeter": "A power meter measures your effort directly.",
