<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ : keep everything out of cloud backup and device-to-device
  transfer. The database is encrypted with a key held in the Android Keystore,
  which is never backed up - so a restored copy of the file could not be
  opened anyway - and "your data stays on this phone" is a promise the app
  makes (docs/PRIVACY.md).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
