  "fixed_sql": [
    {
      "name": "rider_profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rider_profiles\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"display_name\" TEXT NOT NULL, \"birth_year\" INTEGER NOT NULL, \"sex\" TEXT NULL, \"height_cm\" REAL NOT NULL, \"weight_kg\" REAL NOT NULL, \"inseam_mm\" REAL NULL, \"resting_hr_bpm\" INTEGER NULL, \"max_hr_bpm\" INTEGER NULL, \"ftp_watts\" INTEGER NULL, \"lthr_bpm\" INTEGER NULL, \"years_riding\" REAL NOT NULL, \"rides_per_week\" INTEGER NOT NULL, \"typical_ride_minutes\" INTEGER NOT NULL, \"hours_per_week\" REAL NOT NULL, \"goal\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "readiness_screenings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"readiness_screenings\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"questionnaire_version\" INTEGER NOT NULL, \"answers_json\" TEXT NOT NULL, \"any_yes\" INTEGER NOT NULL CHECK (\"any_yes\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "consent_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"consent_records\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"granted\" INTEGER NOT NULL CHECK (\"granted\" IN (0, 1)), \"policy_version\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "bikes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bikes\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"bike_type\" TEXT NOT NULL, \"bead_seat_diameter_mm\" INTEGER NULL, \"tyre_width_mm\" INTEGER NULL, \"roll_out_mm\" REAL NULL, \"crank_length_mm\" REAL NULL, \"pedals\" TEXT NULL, \"saddle_height_mm\" REAL NULL, \"tyre_pressure_kpa\" REAL NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "drivetrains",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"drivetrains\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"bike_id\" TEXT NOT NULL REFERENCES bikes (id) ON DELETE CASCADE, \"chainrings\" TEXT NOT NULL, \"cogs\" TEXT NOT NULL, \"cogs_confirmed\" INTEGER NOT NULL CHECK (\"cogs_confirmed\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sensors",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sensors\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"kind\" TEXT NOT NULL UNIQUE, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
