rules_version = '2';

// Firestore security rules for Kasama / Bike Guide PH.
//
// IMPORTANT: the default "test mode" rules (allow read, write: if true)
// let anyone wipe every hazard and run the read/write bill to whatever
// they like. Deploy these instead:
//   Firebase Console -> Firestore Database -> Rules -> paste -> Publish

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Community hazard reports ──
    // Readable by everyone (that's the point). Creatable by anyone, since
    // the app has no login — but shape-validated so a bad client cannot
    // write junk, and never updatable or deletable from the client.
    match /hazards/{hazardId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(
                        ['lat','lng','type','note','reporter','createdAt','confirms'])
                    && request.resource.data.lat is number
                    && request.resource.data.lng is number
                    // Philippines bounding box — rejects junk and foreign spam.
                    && request.resource.data.lat >= 4.0  && request.resource.data.lat <= 21.5
                    && request.resource.data.lng >= 116.0 && request.resource.data.lng <= 127.0
                    && request.resource.data.type in
                       ['pothole','theft','danger','traffic','flood','dog','construction','glass']
                    && request.resource.data.note is string
                    && request.resource.data.note.size() <= 200
                    && request.resource.data.reporter is string
                    && request.resource.data.reporter.size() <= 64;

      // Moderation happens server-side / in the console, never from a client.
      allow update, delete: if false;
    }

    // ── Per-device private data ──
    // No auth yet, so this is scoped by the device UUID in the path. It is
    // obscurity, not real security: treat it as "keeps honest users apart",
    // and move to Firebase Auth (email/Google — never SMS) before storing
    // anything genuinely sensitive.
    match /users/{deviceId}/{document=**} {
      allow read, write: if deviceId is string && deviceId.size() >= 16;
    }

    // ── Live ride sharing ──
    // The share ID *is* the secret: 8 chars from a 30-char alphabet is
    // ~6.5e11 combinations, so it is not guessable in practice. Anyone
    // holding the link can watch — that is the whole point, and it is the
    // same model as Strava Beacon. Riders can rotate their code in-app if
    // a link spreads further than intended.
    //
    // Note the privacy trade-off honestly: this document holds a person's
    // live position, readable by anyone with the URL. Do not add anything
    // to it that the rider would not want a stranger to see.
    match /liveRides/{shareId} {
      allow read: if true;

      allow create: if shareId.size() >= 6 && shareId.size() <= 32
                    && request.resource.data.riderName is string
                    && request.resource.data.riderName.size() <= 40
                    && request.resource.data.active == true;

      // Only the moving parts may change, and only within sane bounds —
      // so a stray client cannot rewrite the document into something else.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['lat','lng','distanceKm','speedKmh','updatedAt','active','endedAt'])
                    && (request.resource.data.lat == null || (
                         request.resource.data.lat is number
                         && request.resource.data.lat >= 4.0 && request.resource.data.lat <= 21.5))
                    && (request.resource.data.lng == null || (
                         request.resource.data.lng is number
                         && request.resource.data.lng >= 116.0 && request.resource.data.lng <= 127.0));

      allow delete: if false;
    }

    // ── Stolen bike board ──
    // Only documents already marked stolen are readable. That single
    // condition does a lot of work: the serial check returns a hit or
    // nothing, and the collection can never be scraped into a list of
    // every registered bike in the country.
    //
    // Serials are never stored here in the clear — only a SHA-256 hash
    // and the last four characters.
    match /stolenBikes/{reportId} {
      allow read: if resource.data.status == 'stolen';

      allow create: if request.resource.data.status == 'stolen'
                    && request.resource.data.serialHash is string
                    && request.resource.data.serialHash.size() == 64
                    && request.resource.data.brand is string
                    && request.resource.data.brand.size() <= 40
                    && request.resource.data.area is string
                    && request.resource.data.area.size() <= 80
                    && request.resource.data.contact is string
                    && request.resource.data.contact.size() <= 60
                    && request.resource.data.note is string
                    && request.resource.data.note.size() <= 300;

      // A thief must never be able to erase or edit a report.
      allow update, delete: if false;
    }

    // ── Premium payment requests ──
    // Users may submit one; only the console may read or change them.
    match /premiumRequests/{requestId} {
      allow create: if request.resource.data.amount == 79
                    && request.resource.data.status == 'pending'
                    && request.resource.data.gcashRef is string
                    && request.resource.data.gcashRef.size() <= 64;
      allow read, update, delete: if false;
    }

    // ── Premium activation flags ──
    // Written by the developer in the console; the app only reads its own.
    match /premiumUsers/{deviceId} {
      allow read: if true;
      allow write: if false;
    }

    // Deny anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
