# Local development against the Firebase emulators.
#
#   cp .env.emulator.example .env.local
#
# No real Firebase project, no service account key, no billing. Everything
# runs on your machine. Use .env.example instead when you connect to a real
# Firebase project.
#
# You need Node 22+ and a JDK — the Firebase emulators are Java programs.
# Check with `java -version`. If that errors, install one and open a NEW
# terminal so it picks up the changed PATH:
#
#   winget install EclipseAdoptium.Temurin.21.JDK   (Windows)
#   brew install --cask temurin                     (macOS)
#   sudo apt install default-jdk                    (Debian/Ubuntu)
#
# If you cannot install Java, skip the emulators entirely and use a real
# Firebase project: create one at console.firebase.google.com (the free Spark
# plan is enough), turn on Authentication with Email/Password and Cloud
# Firestore, then fill in .env.example instead of this file.
#
#   npm install
#   npm run emulators     # terminal 1 — auth, firestore, storage
#   npm run seed          # terminal 2 — test accounts and training content
#   npm run dev           # terminal 3 — http://localhost:3000
#
# Then sign in at /sign-in as  admin@bfp.gov.ph  /  flare-emulator

# ---------------------------------------------------------- client (public)
# Any values work against the emulators — they identify a project that only
# exists on your machine. The API key is never checked.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=flare-local.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=flare-local
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=flare-local.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# This is what points the BROWSER's Firebase SDK at the emulators. The
# variables below only reach the server, which cannot tell the browser
# anything — so without this, uploads and sign-in try to reach real Firebase.
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true

# ------------------------------------------------------------------- server
# The Admin SDK talks to the emulators whenever these are set, and skips
# credentials entirely — which is why no service account key is needed.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_PROJECT_ID=flare-local
