// AutoCare — Prisma schema
// Target: PostgreSQL (Neon free tier in production, Docker Postgres locally).
//
// Design note on future work (P2, intentionally NOT built in v1):
//   * Role already has room for a CUSTOMER value — adding it plus a nullable
//     User.customerId link is enough to open a customer portal later.
//   * JobPart carries a nullable catalog-style shape so inventory stock levels
//     can be layered on without touching historical rows.
//   * Nothing in the schema assumes a single branch; a Branch model can be added
//     with nullable branchId columns and backfilled.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  // CUSTOMER — reserved for the future customer portal (P2). Not issued in v1.
}

enum JobStatus {
  PAID
  UNPAID
  PARTIAL
}

enum PaymentMethod {
  CASH
  GCASH
  OTHER
}

/// How a payment came in. See the Payment model.
enum PaymentKind {
  /// Paid when the job was recorded.
  WITH_JOB
  /// Collected later — "Tumanggap ng bayad" on a job that was still owed.
  COLLECTED
  /// The amount paid was changed by editing the job (may be negative).
  ADJUSTMENT
}

model User {
  id                  String    @id @default(cuid())
  name                String
  username            String    @unique
  passwordHash        String
  role                Role      @default(STAFF)
  /// BCP-47-ish locale code, e.g. "fil", "en", "es". Stored as a string so a new
  /// language can be added by dropping one file into /messages — no migration.
  locale              String    @default("fil")
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  /// Set the first time the user acknowledges the Acceptable Use Policy.
  policyAcceptedAt    DateTime?

  /// Bumped whenever the account is disabled or its password is reset. Any
  /// session carrying an older value is rejected on the next request, so
  /// "turn this account off" takes effect immediately instead of waiting for
  /// the JWT to expire. See lib/session.ts.
  tokenVersion Int @default(0)

  /// Forces a password change before the user can do anything else. Set on
  /// accounts created by an admin and on the seeded owner accounts, whose
  /// starting passwords are known.
  mustChangePassword Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdCustomers Customer[] @relation("CustomerCreatedBy")
  createdJobs      Job[]      @relation("JobCreatedBy")
  receivedPayments Payment[]  @relation("PaymentReceivedBy")
  mechanicJobs     Job[]      @relation("JobMechanic")
  deletedJobs      Job[]      @relation("JobDeletedBy")
  auditLogs        AuditLog[]

  @@index([role])
  @@index([isActive])
}

model Customer {
  id          String   @id @default(cuid())
  fullName    String
  phone       String?
  address     String?
  notes       String?
  createdById String
  createdBy   User     @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicles Vehicle[]
  jobs     Job[]

  @@index([fullName])
  @@index([phone])
  @@index([createdById])
}

model Vehicle {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plateNumber String
  make        String?
  model       String?
  year        Int?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs Job[]

  @@index([customerId])
  @@index([plateNumber])
}

/// Catalog of repeatable services. Editing an entry here never changes an
/// already-issued receipt: JobService stores its own name and price.
model Service {
  id                String   @id @default(cuid())
  name              String   @unique
  defaultPrice      Decimal  @db.Decimal(12, 2)
  isActive          Boolean  @default(true)
  /// When a car should come back after this service ("change oil every 3
  /// months or 5,000 km"). Either may be null. A job's next visit is worked
  /// out from the shortest interval among its services — see lib/reminders.ts.
  remindAfterMonths Int?
  remindAfterKm     Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  jobServices JobService[]

  @@index([isActive])
}

model Job {
  id         String    @id @default(cuid())
  jobNumber  String    @unique
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  vehicleId  String
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id])
  mechanicId String?
  mechanic   User?     @relation("JobMechanic", fields: [mechanicId], references: [id])
  date       DateTime  @default(now())
  status     JobStatus @default(UNPAID)

  laborCharge Decimal @default(0) @db.Decimal(12, 2)
  expenses    Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  amountPaid  Decimal @default(0) @db.Decimal(12, 2)
  balance     Decimal @db.Decimal(12, 2)

  paymentMethod PaymentMethod?
  notes         String?

  /// The odometer reading when the car came in, in km.
  odometerKm     Int?
  /// When the car is due back, printed on the receipt like a change-oil
  /// sticker. A calendar date; km is "or at this reading, whichever first".
  nextVisitOn    DateTime? @db.Date
  nextVisitKm    Int?
  /// Set when the shop has contacted the customer about the next visit (or
  /// chose not to), which takes the job off the Babalikan list. The list also
  /// drops a job by itself once the same car has a newer job with its own
  /// next visit.
  reminderDoneAt DateTime?

  createdById String
  createdBy   User     @relation("JobCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Soft delete. A job is the shop's financial record, so "Burahin" moves it
  /// to the Trash instead of destroying it. Every query for live jobs filters
  /// on `deletedAt: null` (see lib/jobs.ts `notDeleted`). An ADMIN can restore
  /// it, or purge it for good from the Trash page.
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("JobDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  parts    JobPart[]
  services JobService[]
  payments Payment[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([date])
  @@index([status])
  @@index([createdById])
  @@index([deletedAt])
  /// The dashboard and jobs list always filter live jobs by date.
  @@index([deletedAt, date])
  /// The Babalikan list: open reminders by due date.
  @@index([nextVisitOn])
  @@index([vehicleId, date])
}

model JobPart {
  id        String  @id @default(cuid())
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  partName  String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  @@index([jobId])
  @@index([partName])
}

model JobService {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// Denormalised on purpose — a historical receipt must never change when the
  /// Service catalog is edited or a catalog entry is deleted.
  serviceName String
  price       Decimal @db.Decimal(12, 2)

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([serviceId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}

/// Single-row table holding the shop details printed on every receipt.
/// Editable from the Settings page by an ADMIN.
///
/// Branding (accent, logo) lets each shop that installs AutoCare make it look
/// like its own: one install per shop, each with its own row here.
model ShopSetting {
  id        String   @id @default("shop")
  name      String
  address   String
  phone     String
  email     String?
  footer    String?
  /// Tax Identification Number, printed on the receipt when set.
  tin       String?
  /// One of the curated accent colours in lib/branding.ts ("kahel", "asul", …).
  accent    String   @default("kahel")
  /// The shop's logo as a PNG data URL (resized in the browser, re-checked on
  /// the server: PNG signature, at most 512×512 and 300 KB). Null = monogram.
  logo      String?
  updatedAt DateTime @updatedAt
}

/// A sign-in that has been logged out. Sessions are JWT cookies, which the
/// server cannot recall; recording the sign-in's id here is what makes "Log
/// out" final even if a request still in flight re-issues the cookie.
/// Rows are deleted once expired (see lib/session.ts).
model RevokedSession {
  sid       String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// One payment towards a job: money that came into the shop on a given day.
///
/// The invariant, kept inside every transaction that writes either table:
/// the payments of a job add up to its `amountPaid`. `Job.amountPaid` stays
/// as the running sum because balance and status are derived from it (see
/// lib/calc.ts); this table adds *when* each peso arrived, so "money today"
/// counts a debt collected today, not the day the job was done.
model Payment {
  id           String         @id @default(cuid())
  jobId        String
  job          Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Positive for money received. Negative only for an ADJUSTMENT that
  /// lowered the amount paid (a correction).
  amount       Decimal        @db.Decimal(12, 2)
  method       PaymentMethod?
  kind         PaymentKind
  /// The shop's calendar date the money arrived — what the dashboard and the
  /// reports count. A date, not a time, so no timezone can move it.
  receivedOn   DateTime       @db.Date
  receivedById String?
  receivedBy   User?          @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())

  @@index([jobId])
  @@index([receivedOn])
}

/// Per-year counter backing the human-readable job number (JOB-2026-0001).
/// Incremented inside the same transaction that creates the Job.
model JobCounter {
  year       Int @id
  lastNumber Int @default(0)
}
