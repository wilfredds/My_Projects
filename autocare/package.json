{
  "name": "autocare",
  "version": "1.0.0",
  "private": true,
  "description": "AutoCare — information management system for HI-OCTEN CAR CARE SERVICES",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:vercel": "if [ \"$VERCEL_ENV\" = production ]; then prisma migrate deploy; fi && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/calc.test.ts tests/validation.test.ts",
    "test:db": "tsx tests/job-integrity.test.ts && tsx tests/security.test.ts && tsx tests/access-control.test.ts",
    "test:all": "npm run test && npm run test:db",
    "seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@react-pdf/renderer": "4.5.1",
    "bcryptjs": "2.4.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "0.468.0",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.13.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "recharts": "2.15.0",
    "sonner": "1.7.2",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.25",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.8",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "postcss": "8.5.25"
  }
}
